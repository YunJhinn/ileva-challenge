# Database driver: "sqlite" (zero-config, default) or "mysql"
DB_CONNECTION=sqlite

# Used only when DB_CONNECTION=sqlite
DB_SQLITE_PATH=database/database.sqlite

# Used only when DB_CONNECTION=mysql (matches docker-compose.yml)
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=contacts
DB_USERNAME=contacts
DB_PASSWORD=secret

# Comma-separated list of origins allowed to call the API from the browser.
# Use "*" to allow any origin (fine for this challenge / local dev).
CORS_ALLOWED_ORIGINS=*
